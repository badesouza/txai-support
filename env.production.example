# =============================================================================
# TXAI Support System - Production Environment
# =============================================================================

# Application
NODE_ENV=production
PORT=3001

# Database Configuration (Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/txai_support

# JWT Configuration
JWT_SECRET=seu_jwt_secret_super_seguro_para_producao_mude_isto_imediatamente
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGINS=https://your-project-id.web.app,https://your-project-id.firebaseapp.com
# CORS_ORIGIN=https://seu-dominio

# File Upload Configuration
UPLOAD_PATH=./uploads
STORAGE_DRIVER=local
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_CREDENTIALS_JSON=
GCS_UPLOADS_PREFIX=uploads
GCS_SIGNED_URL_TTL_SECONDS=900
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
EMAIL_FROM=noreply@txai-support.com

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./whatsapp-sessions
WHATSAPP_WEBHOOK_URL=http://31.97.170.240/api/whatsapp/webhook
CHROME_PATH=/usr/bin/chromium-browser

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Performance
NODE_OPTIONS=--max-old-space-size=1024
