# =============================================================================
# TXAI Support - Production Environment (Cloud Run)
# =============================================================================
# Notes:
# - Database is Firestore (no DATABASE_URL).
# - Uploads are stored in GCS (private bucket; backend generates signed URLs).
# - Redis is expected to be Redis Cloud (TLS) when enabled.
# =============================================================================

NODE_ENV=production
PORT=3001

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_PROD
JWT_EXPIRES_IN=24h

# Initial admin user (seeded on startup if missing)
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_PROD

# CORS (CSV)
CORS_ORIGINS=https://your-project-id.web.app,https://your-project-id.firebaseapp.com

# -----------------------------------------------------------------------------
# Firestore (Firebase Admin SDK)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=your-project-id
# Option A: Provide service account JSON (as a single env var)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
#
# Option B: Use Application Default Credentials (recommended on Cloud Run)
# (leave FIREBASE_CREDENTIALS_JSON unset)

# -----------------------------------------------------------------------------
# Storage (GCS)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=gcs
GCS_BUCKET=your-project-uploads
GCS_PROJECT_ID=your-project-id
GCS_UPLOADS_PREFIX=uploads
GCS_SIGNED_URL_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Redis (Redis Cloud with TLS)
# -----------------------------------------------------------------------------
REDIS_URL=rediss://default:PASSWORD@HOST:PORT/0
WHATSAPP_TOKEN_STORE=redis

# -----------------------------------------------------------------------------
# WhatsApp (WPPConnect-Server)
# -----------------------------------------------------------------------------
WHATSAPP_DRIVER=server
WPPCONNECT_BASE_URL=http://wppconnect-server:21465
WPPCONNECT_SESSION=txai-whatsapp
WPPCONNECT_SECRET_KEY=CHANGE_ME_PROD
WPPCONNECT_WEBHOOK_SECRET=CHANGE_ME_PROD
