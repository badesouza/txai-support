# =============================================================================
# TXAI Support System - Production Environment
# =============================================================================

# Application
NODE_ENV=production
PORT=3001

# Database Configuration (MySQL)
DATABASE_URL=mysql://txai:Acaraje123@localhost:3306/txai_support
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=txai_support
MYSQL_USER=txai
MYSQL_PASSWORD=Acaraje123

# JWT Configuration
JWT_SECRET=seu_jwt_secret_super_seguro_para_producao_mude_isto_imediatamente
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://31.97.170.240

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
EMAIL_FROM=noreply@txai-support.com

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./whatsapp-sessions
WHATSAPP_WEBHOOK_URL=http://31.97.170.240/api/whatsapp/webhook
CHROME_PATH=/usr/bin/chromium-browser

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Performance
NODE_OPTIONS=--max-old-space-size=1024
