# Frontend Dockerfile - Development
FROM node:18-alpine

# Definir diretório de trabalho
WORKDIR /app

# Copiar arquivos de dependências
COPY frontend/package*.json ./

# Instalar dependências
RUN npm ci

# Copiar código fonte
COPY frontend/ ./

# Expor porta
EXPOSE 3000

# Comando de desenvolvimento
CMD ["npm", "start"]
