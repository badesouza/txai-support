# =============================================================================
# TXAI Support - Local Development Environment (.env)
# =============================================================================
# Usage:
#   cp env.example .env
#   docker-compose up -d --build
#
# Notes:
# - Database is Firestore (local uses Firebase Emulator via docker-compose).
# - Uploads are stored in GCS (local uses fake-gcs-server via docker-compose).
# - WhatsApp integration defaults to WPPConnect-Server in docker-compose.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (Express)
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# JWT (required for local auth)
JWT_SECRET=change-me-local-dev
JWT_EXPIRES_IN=24h

# Initial admin user (seeded on backend startup)
ADMIN_DEFAULT_PASSWORD=admin123

# CORS (CSV). If unset, backend falls back to local defaults.
# CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# Optional: disable WhatsApp integration entirely
# WHATSAPP_ENABLED=false

# WhatsApp driver:
# - server (WPPConnect-Server container + webhook)
# - direct (Puppeteer + @wppconnect-team/wppconnect in backend)
WHATSAPP_DRIVER=server

# WPPConnect-Server shared secrets (must match between backend and wppconnect-server)
WPPCONNECT_SECRET_KEY=THISISMYSECURETOKEN
WPPCONNECT_WEBHOOK_SECRET=txai-webhook-secret

# Optional: WPPConnect-Server base URL/session name
# WPPCONNECT_BASE_URL=http://wppconnect-server:21465
# WPPCONNECT_SESSION=txai-whatsapp

# -----------------------------------------------------------------------------
# Storage (GCS)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=gcs
GCS_BUCKET=txai-uploads
GCS_PROJECT_ID=local-dev
GCS_UPLOADS_PREFIX=uploads
GCS_SIGNED_URL_TTL_SECONDS=900

# Local emulator wiring (docker-compose)
STORAGE_EMULATOR_HOST=http://fake-gcs:4443
GCS_PUBLIC_HOST=http://localhost:4443

# -----------------------------------------------------------------------------
# Firestore (Firebase Admin SDK)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=local-dev
FIRESTORE_EMULATOR_HOST=firebase-emulator:8082
FIREBASE_AUTH_EMULATOR_HOST=firebase-emulator:9099

# -----------------------------------------------------------------------------
# Redis (WhatsApp session token store)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
WHATSAPP_TOKEN_STORE=redis

# -----------------------------------------------------------------------------
# Optional: request body size limit (WPPConnect webhooks may include base64 media)
# -----------------------------------------------------------------------------
# JSON_BODY_LIMIT=25mb
