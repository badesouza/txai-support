# =============================================================================
# TXAI Support System - Environment Configuration
# =============================================================================

# Application
NODE_ENV=development
PORT=3001

# Database Configuration (Postgres)
DATABASE_URL=postgresql://txai:txai123@localhost:5433/txai_support

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# File Upload Configuration
UPLOAD_PATH=./uploads
STORAGE_DRIVER=local
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_CREDENTIALS_JSON=
GCS_UPLOADS_PREFIX=uploads
GCS_SIGNED_URL_TTL_SECONDS=900
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Email Configuration (for password recovery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@txai-support.com

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./whatsapp-sessions
WHATSAPP_WEBHOOK_URL=http://localhost:3001/api/whatsapp/webhook
CHROME_PATH=/usr/bin/chromium-browser

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Production Settings (override these for production)
# NODE_ENV=production
# DATABASE_URL=postgresql://user:pass@host:5432/txai_support
# CORS_ORIGINS=https://your-project-id.web.app,https://your-project-id.firebaseapp.com
# JWT_SECRET=your_production_jwt_secret
# SMTP_HOST=your_production_smtp_host
# SMTP_USER=your_production_email
# SMTP_PASS=your_production_password
# CHROME_PATH=/usr/bin/chromium-browser 
