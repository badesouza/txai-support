{
  "secretKey": "THISISMYSECURETOKEN",
  "host": "http://localhost",
  "port": "21465",
  "customUserDataDir": "./userDataDir/",
  "startAllSession": false,
  "maxListeners": 15,
  "webhook": {
    "url": null,
    "autoDownload": false,
    "readMessage": false,
