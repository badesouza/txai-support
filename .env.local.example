# =============================================================================
# Root Environment Variables (Shared across services)
# =============================================================================
# Copy this file to .env.local and customize as needed.
# =============================================================================

# PostgreSQL
POSTGRES_USER=txai
POSTGRES_PASSWORD=txai_secret
POSTGRES_DB=txai_support
POSTGRES_PORT=5432

# WPPConnect Configuration
WPPCONNECT_SECRET_KEY=dev-secret-key
WPPCONNECT_WEBHOOK_SECRET=dev-webhook-secret
WPPCONNECT_SESSION=txai-whatsapp

# Platform override for WPPConnect (amd64 or arm64)
# WPPCONNECT_PLATFORM=linux/arm64

# Admin Credentials (used by seed script)
ADMIN_DEFAULT_PASSWORD=admin123
JWT_SECRET=dev-jwt-secret-change-in-production

# Backend
BACKEND_PORT=3001

# Public URLs - set to your VPS IP/domain before deploying.
PUBLIC_BASE_URL=http://localhost:3001
PUBLIC_FRONTEND_URL=http://localhost:8081
