{
  "name": "txai-support",
  "version": "1.0.0",
  "description": "TXAI Support - Helpdesk System with WhatsApp Integration",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-start.js",
    "dev:services": "docker compose -f docker-compose.dev.yml up",
    "dev:services:detached": "docker compose -f docker-compose.dev.yml up -d",
    "dev:services:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:services:stop": "docker compose -f docker-compose.dev.yml down",
    "dev:services:restart": "docker compose -f docker-compose.dev.yml restart",
    "dev:services:status": "docker compose -f docker-compose.dev.yml ps"
  },
  "keywords": [
    "helpdesk",
    "whatsapp",
    "firebase",
    "nodejs"
  ],
  "author": "",
  "license": "MIT"
}

