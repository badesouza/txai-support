rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      // Allow authenticated users to read their own data
      // Backend uses Admin SDK which bypasses these rules
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only backend can write
    }

    // Calls collection
    match /calls/{callId} {
      // Allow authenticated users to read their own calls
      allow read: if request.auth != null;
      allow write: if false; // Only backend can write
    }

    // Call images
    match /callImages/{imageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User tokens
    match /userTokens/{tokenId} {
      allow read, write: if false; // Only backend
    }

    // Call status history
    match /callStatusHistory/{historyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // WhatsApp messages
    match /whatsappMessages/{messageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Counters (for pagination)
    match /counters/{counterId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

