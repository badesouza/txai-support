# =============================================================================
# TXAI Support - Root Environment (Shared Config)
# =============================================================================
# Copy to .env (used by docker-compose) and customize.
# =============================================================================

# PostgreSQL
POSTGRES_USER=txai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=txai_support
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3001
JWT_SECRET=change-me-use-openssl-rand-hex-48
ADMIN_DEFAULT_PASSWORD=change-me

# WPPConnect
WPPCONNECT_SECRET_KEY=change-me
WPPCONNECT_WEBHOOK_SECRET=change-me
WPPCONNECT_SESSION=txai-whatsapp
WPPCONNECT_PLATFORM=linux/amd64

# Public URLs - set to your VPS IP/domain before deploying.
PUBLIC_BASE_URL=http://localhost:3001
PUBLIC_FRONTEND_URL=http://localhost:8081
