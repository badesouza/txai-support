# =============================================================================
# TXAI Support - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# cp .env.example .env
#
# NEVER commit .env to git!
# =============================================================================

# JWT Secret - generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-me

# Default admin password for seeding (only used on first run)
# The admin user will be created with email: admin@txai.com
ADMIN_DEFAULT_PASSWORD=change-me-to-a-secure-password

# =============================================================================
# Cloud Environment (uncomment and fill for hybrid/cloud mode)
# =============================================================================
# GCP_PROJECT_ID=your-gcp-project
# REDIS_CLOUD_URL=redis://default:password@your-redis-host:port
# GCS_BUCKET=your-production-bucket
