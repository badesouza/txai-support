# =============================================================================
# TXAI Support - Root Environment (Shared Config)
# =============================================================================
# Copy to .env.local for local development
# These vars are shared across frontend, backend, and infra
# =============================================================================

# GCP Configuration
GCP_PROJECT_ID=local-dev
REGION=us-central1

# Firebase (for deployments)
FIREBASE_PROJECT_ID=your-project-id
# Get token with: firebase login:ci
FIREBASE_TOKEN=

# GitHub (for CI/CD)
GITHUB_OWNER=your-username
GITHUB_REPO=your-repo

# Terraform State (for infra deployments)
TF_STATE_BUCKET=your-project-tfstate
ENVIRONMENT_NAME=dev
