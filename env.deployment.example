# =============================================================================
# Deployment Configuration Template
# =============================================================================
# Copy to .env.deployment and fill in values (don't commit!)
# Use: source .env.deployment before running deployment scripts

# GCP Configuration
# -----------------
PROJECT_ID=your-gcp-project-id
REGION=us-central1
ENVIRONMENT_NAME=dev

# Terraform State
# ---------------
TF_STATE_BUCKET=your-project-tfstate
TF_STATE_PREFIX=txai-support/dev

# Firebase Configuration
# -----------------------
# Get token with: firebase login:ci
# IMPORTANT: Keep this secret! Store in CI/CD secrets, not in git
FIREBASE_TOKEN=

# CORS Configuration
# ------------------
# Auto-detected from Firebase project if not set
# Format: Comma-separated URLs without spaces
# CORS_ORIGINS=https://your-app.web.app,https://your-app.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id

# GitHub Configuration (for bootstrap)
# -------------------------------------
GITHUB_OWNER=your-username
GITHUB_REPO=your-repo

# Backend Environment Variables (optional overrides)
# ---------------------------------------------------
# These are typically managed by Terraform, but can be overridden

# JWT Secret (generate with: openssl rand -base64 32)
# JWT_SECRET=

# Node Environment
# NODE_ENV=production

# SMTP Configuration (for email)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=noreply@your-domain.com

# Rate Limiting
# RATE_LIMIT_WINDOW=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Backend Service Configuration
# ------------------------------
# AR_REPO=txai-support
# IMAGE_NAME=txai-backend
# SERVICE_NAME=txai-backend
# SERVICE_ACCOUNT=  # Auto-set by Terraform

# Preview Deployments
# -------------------
# Set to 'true' to deploy frontend to preview channel
# PREVIEW=false

# =============================================================================
# Usage Examples
# =============================================================================

# 1. First-time deployment:
#    source .env.deployment
#    ./scripts/gcp/first-time-deploy.sh

# 2. Deploy infrastructure and applications:
#    source .env.deployment
#    ./scripts/gcp/deploy-all.sh

# 3. Deploy backend only:
#    source .env.deployment
#    ./scripts/gcp/deploy-backend.sh

# 4. Deploy frontend only:
#    source .env.deployment
#    export API_URL=https://your-backend-url.run.app/api
#    ./scripts/gcp/deploy-frontend-firebase.sh

# 5. Preview deployment:
#    source .env.deployment
#    export PREVIEW=true
#    export API_URL=https://your-backend-url.run.app/api
#    ./scripts/gcp/deploy-frontend-firebase.sh

# =============================================================================
# Security Best Practices
# =============================================================================

# 1. Never commit this file to git (it's in .gitignore)
# 2. Store FIREBASE_TOKEN in CI/CD secrets (GitHub Secrets, etc.)
# 3. Rotate tokens periodically
# 4. Use strong, unique secrets for JWT_SECRET
# 5. Keep production credentials separate from development

