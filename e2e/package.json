{
  "name": "txai-support-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright-based headless smoke tests for TXAI Support (frontend + backend).",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
