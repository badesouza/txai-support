# =============================================================================
# Backend Environment Variables - Local Development Mode
# =============================================================================
# Copy this file to .env.local for local development with hot reload.
# These settings connect to Docker services running via docker-compose.dev.yml
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=3001

# =============================================================================
# Firebase Emulator (Docker container on localhost)
# =============================================================================
FIRESTORE_EMULATOR_HOST=localhost:8082
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
GCP_PROJECT_ID=local-dev
FIREBASE_PROJECT_ID=local-dev

# =============================================================================
# Storage - GCS Emulator (Docker container on localhost)
# =============================================================================
STORAGE_DRIVER=gcs
STORAGE_EMULATOR_HOST=http://localhost:4443
GCS_BUCKET=txai-uploads
GCS_PROJECT_ID=local-dev
GCS_PUBLIC_HOST=http://localhost:4443
GCS_UPLOADS_PREFIX=uploads

# =============================================================================
# WhatsApp - WPPConnect Server (Docker container on localhost)
# =============================================================================
WHATSAPP_DRIVER=server
WHATSAPP_ENABLED=true
WPPCONNECT_BASE_URL=http://localhost:21465
WPPCONNECT_SESSION=txai-whatsapp
WPPCONNECT_SECRET_KEY=dev-secret-key
WPPCONNECT_WEBHOOK_SECRET=dev-webhook-secret

# =============================================================================
# Authentication
# =============================================================================
JWT_SECRET=dev-jwt-secret-change-in-production
ADMIN_DEFAULT_PASSWORD=admin123

# =============================================================================
# CORS - Frontend dev server
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# =============================================================================
# Telemetry (disabled for local dev)
# =============================================================================
ENABLE_TELEMETRY=false
