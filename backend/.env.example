# =============================================================================
# TXAI Support - Backend Environment
# =============================================================================
# Copy to .env.local for local development
# Also source root ../.env.local for shared vars
# =============================================================================

# Server
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change-me-use-openssl-rand-base64-32
JWT_EXPIRES_IN=24h

# Initial admin user
ADMIN_DEFAULT_PASSWORD=admin123

# CORS (comma-separated, or leave empty for defaults)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# WhatsApp Integration
# =============================================================================

WHATSAPP_DRIVER=server
WPPCONNECT_BASE_URL=http://localhost:21465
WPPCONNECT_SESSION=txai-whatsapp
WPPCONNECT_SECRET_KEY=THISISMYSECURETOKEN
WPPCONNECT_WEBHOOK_SECRET=txai-webhook-secret
WHATSAPP_TOKEN_STORE=redis

# =============================================================================
# Storage (GCS)
# =============================================================================

STORAGE_DRIVER=gcs
GCS_BUCKET=txai-uploads
GCS_UPLOADS_PREFIX=uploads
GCS_SIGNED_URL_TTL_SECONDS=900

# Local emulator (for docker-compose)
# STORAGE_EMULATOR_HOST=http://localhost:4443
# GCS_PUBLIC_HOST=http://localhost:4443

# =============================================================================
# Firebase / Firestore
# =============================================================================

# Local emulator
FIRESTORE_EMULATOR_HOST=localhost:8082
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# =============================================================================
# Redis
# =============================================================================

REDIS_URL=redis://localhost:6379

# =============================================================================
# Database (if using PostgreSQL instead of Firestore)
# =============================================================================

# DATABASE_URL=postgresql://txai:txai123@localhost:5432/txai_support
