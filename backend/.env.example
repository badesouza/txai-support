# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h

# Firebase / GCP Project
GCP_PROJECT_ID=your-gcp-project-id
FIREBASE_PROJECT_ID=your-gcp-project-id

# Admin User Seed (required for first deployment)
ADMIN_DEFAULT_PASSWORD=admin123

# OpenTelemetry & Honeycomb Configuration
ENABLE_TELEMETRY=true
OTEL_SERVICE_NAME=txai-support-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io:443
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_HONEYCOMB_API_KEY_HERE
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# SMTP (for password-reset emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
BASE_URL=http://localhost:4000

# Uploads
UPLOAD_DIR=uploads
