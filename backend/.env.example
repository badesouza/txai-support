# =============================================================================
# TXAI Support - Backend Environment
# =============================================================================
# Copy to .env.local for local development
# =============================================================================

# Server
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change-me-use-openssl-rand-base64-32
JWT_EXPIRES_IN=24h

# Initial admin user
ADMIN_DEFAULT_PASSWORD=admin123

# CORS (comma-separated, or leave empty for defaults)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# WhatsApp Integration
# =============================================================================

WHATSAPP_DRIVER=server
WPPCONNECT_BASE_URL=http://localhost:21465
WPPCONNECT_SESSION=txai-whatsapp
WPPCONNECT_SECRET_KEY=THISISMYSECURETOKEN
WPPCONNECT_WEBHOOK_SECRET=txai-webhook-secret
WHATSAPP_TOKEN_STORE=redis

# =============================================================================
# Storage (local disk)
# =============================================================================

STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
UPLOADS_PREFIX=uploads
PUBLIC_BASE_URL=http://localhost:3001

# =============================================================================
# Redis
# =============================================================================

REDIS_URL=redis://localhost:6379

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

DATABASE_URL=postgresql://txai:txai_secret@localhost:5432/txai_support
