generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                 @id @default(autoincrement())
  name             String
  email            String              @unique
  password         String
  phone            String
  profile          Profile             @default(USER)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  calls            Call[]
  tokens           UserToken[]
  statusHistory    CallStatusHistory[]
  whatsappMessages WhatsAppMessage[]

  @@map("users")
}

model Call {
  id               Int                 @id @default(autoincrement())
  title            String
  description      String
  status           String
  priority         String
  userId           Int
  user             User                @relation(fields: [userId], references: [id])
  images           CallImage[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  statusHistory    CallStatusHistory[]
  whatsappMessages WhatsAppMessage[]

  @@map("calls")
}

model CallImage {
  id        Int      @id @default(autoincrement())
  filename  String
  path      String
  callId    Int
  call      Call     @relation(fields: [callId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("call_images")
}

model UserToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_tokens")
}

model CallStatusHistory {
  id        Int      @id @default(autoincrement())
  callId    Int
  oldStatus String
  newStatus String
  userId    Int
  createdAt DateTime @default(now())
  call      Call     @relation(fields: [callId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("call_status_history")
}

model WhatsAppMessage {
  id          Int      @id @default(autoincrement())
  callId      Int?
  userId      Int?
  phone       String
  message     String
  messageType String   @default("text") // text, image, document
  isFromUser  Boolean  @default(true) // true if from user, false if from system
  createdAt   DateTime @default(now())
  call        Call?    @relation(fields: [callId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@map("whatsapp_messages")
}

enum Profile {
  ADMIN
  USER
}

enum CallStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
