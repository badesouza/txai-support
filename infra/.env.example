# =============================================================================
# TXAI Support - Infrastructure Environment
# =============================================================================
# Copy to .env.local for Terraform deployments
# Source before running: source infra/.env.local
# =============================================================================

# GCP Project (inherits from root if not set)
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Terraform State
TF_STATE_BUCKET=your-project-tfstate
TF_STATE_PREFIX=txai-support/dev

